# Cloudflare Pages 项目配置（同时兼容 wrangler 本地开发 / 部署）
# 说明：
#  - pages_build_output_dir = "." 表示用仓库根目录作为站点静态输出
#  - 认证逻辑在根级 _worker.js（Pages Functions），静态资源经 env.ASSETS 提供
#  - D1 绑定名固定为 DB（见 _worker.js）

name = "cn-math-taxonomy"
pages_build_output_dir = "."
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

# D1 绑定在 Cloudflare Pages 控制台设置：Settings → Functions/Bindings → D1 database bindings
# 变量名 DB，选择你的数据库（数据库 ID 见 D1 控制台，无需写在本文件）
# 本地开发可用 wrangler pages dev . --binding DB=... （或临时恢复 [[d1_databases]] 段）
# migrations_dir = "migrations"
# [[d1_databases]]
# binding = "DB"
# database_name = "cn-math-taxonomy-db"
# database_id = "在 Pages 里不需要；本地开发才填"

# 本地开发需设置的环境变量（生产请在 Cloudflare Pages 控制台设置，勿提交真实密值）
# [vars]
# SITE_PASSWORD = "本地调试用密码"
# SESSION_SECRET = "本地调试用会话密钥"
